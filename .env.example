E2B_API_KEY="your-e2b-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
OPENBOX_URL="https://core.openbox.ai"
OPENBOX_API_KEY="obx_live_your_openbox_api_key"
# IAM v3 workload identity: the workload private key (PEM) shown when the agent was created.
OPENBOX_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
OPENBOX_GOVERNANCE_POLICY="fail_closed"
OPENBOX_VALIDATE="true"
OPENBOX_GOVERNANCE_TIMEOUT="5000"